// © FlowEdge — Gamma Wall Levels
//
// Plots dealer-positioning levels (gamma wall, call/put walls, gamma flip)
// with a GEX-by-strike profile and regime shading.
//
// WHY THE LEVELS ARE INPUTS, NOT FETCHED:
// Pine Script has no HTTP access — an indicator cannot call an options API.
// So FlowEdge computes the levels from the live options chain and you paste
// them in. The Gamma tab has a "Copy Pine inputs" button that puts every
// value below on your clipboard in order.
//
// Refresh whenever the chain moves materially — GEX shifts intraday, and
// hardest around OpEx and after big moves.

//@version=6
indicator("FlowEdge — Gamma Wall Levels", "FE Gamma", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

// ── Levels ──────────────────────────────────────────────────────────────────
g_lvl = "Levels (from FlowEdge Gamma tab)"
gammaWall = input.float(0.0, "Gamma Wall  (Γ magnet)",   group = g_lvl, tooltip = "Strike with the largest positive net GEX. Dealers hedge against price here, so it acts as a magnet/pin.")
callWall  = input.float(0.0, "Call Wall   (resistance)", group = g_lvl, tooltip = "Heaviest call open interest above spot. Dealer short-gamma hedging tends to cap rallies into it.")
putWall   = input.float(0.0, "Put Wall    (support)",    group = g_lvl, tooltip = "Heaviest put open interest below spot. Often where downside hedging flow slows a selloff.")
flipLevel = input.float(0.0, "Gamma Flip  (regime line)",group = g_lvl, tooltip = "Zero-gamma level. Above it dealers are long gamma (moves get dampened); below it they're short gamma (moves get amplified).")
netGex    = input.float(0.0, "Net GEX ($B)",             group = g_lvl, tooltip = "Total net gamma exposure in billions. Positive = suppressive tape, negative = accelerative.")

scaleMult = input.float(1.0, "Scale multiplier", minval = 0.0001, group = g_lvl, tooltip = "Use 10 when the levels come from SPY but you're charting SPX. Leave 1 when the chart and the chain are the same instrument.")

// ── GEX profile ─────────────────────────────────────────────────────────────
g_prof = "GEX profile"
showProfile = input.bool(true, "Show GEX-by-strike profile", group = g_prof)
profileStr  = input.string("", "GEX data  strike:gex,…", group = g_prof, tooltip = "Paste from FlowEdge: 7300:1.2,7350:-0.8,7400:2.4 — strike:netGEX in $B. Positive bars extend green, negative red.")
profileW    = input.int(60, "Profile width (bars)", minval = 10, maxval = 300, group = g_prof)

// ── Display ─────────────────────────────────────────────────────────────────
g_disp = "Display"
lookback    = input.int(120, "Line start (bars back)", minval = 10, group = g_disp)
showLabels  = input.bool(true,  "Show level labels",   group = g_disp)
showTable   = input.bool(true,  "Show info table",     group = g_disp)
shadeRegime = input.bool(true,  "Shade gamma regime",  group = g_disp)

cGamma = input.color(color.new(#a855f7, 0),  "Gamma wall", group = g_disp, inline = "c1")
cCall  = input.color(color.new(#10b981, 0),  "Call wall",  group = g_disp, inline = "c1")
cPut   = input.color(color.new(#ef4444, 0),  "Put wall",   group = g_disp, inline = "c2")
cFlip  = input.color(color.new(#f59e0b, 0),  "Flip",       group = g_disp, inline = "c2")

// ── Scaled levels ───────────────────────────────────────────────────────────
gw = gammaWall * scaleMult
cw = callWall  * scaleMult
pw = putWall   * scaleMult
fl = flipLevel * scaleMult

// Positive gamma when price sits above the flip — dealers dampen moves.
// Below it they amplify, which is the regime that produces trend days.
posGamma = fl > 0 and close > fl

// ── Draw ────────────────────────────────────────────────────────────────────
// Levels are static per input set, so redraw only on the last bar
var line lnGw = na, var line lnCw = na, var line lnPw = na, var line lnFl = na
var label lbGw = na, var label lbCw = na, var label lbPw = na, var label lbFl = na
var box bgRegime = na
var table info = na
var box[]   profBoxes = array.new_box()
var label[] profLabels = array.new_label()

drawLevel(float px, color col, string txt, line ln, label lb, int style) =>
    line  outLn = ln
    label outLb = lb
    if px > 0
        if na(outLn)
            outLn := line.new(bar_index - lookback, px, bar_index, px, xloc = xloc.bar_index, extend = extend.right, color = col, width = 2, style = style)
        else
            line.set_xy1(outLn, bar_index - lookback, px)
            line.set_xy2(outLn, bar_index, px)
            line.set_color(outLn, col)
        if showLabels
            dist = close > 0 ? (px - close) / close * 100 : 0.0
            s = txt + "  " + str.tostring(px, format.mintick) + "  (" + (dist >= 0 ? "+" : "") + str.tostring(dist, "#.##") + "%)"
            if na(outLb)
                outLb := label.new(bar_index + 12, px, s, xloc = xloc.bar_index, style = label.style_label_left, color = color.new(col, 82), textcolor = col, size = size.small)
            else
                label.set_xy(outLb, bar_index + 12, px)
                label.set_text(outLb, s)
                label.set_textcolor(outLb, col)
                label.set_color(outLb, color.new(col, 82))
        else if not na(outLb)
            label.delete(outLb)
            outLb := na
    [outLn, outLb]

if barstate.islast
    [l1, b1] = drawLevel(gw, cGamma, "GAMMA WALL", lnGw, lbGw, line.style_solid)
    lnGw := l1, lbGw := b1
    [l2, b2] = drawLevel(cw, cCall,  "CALL WALL",  lnCw, lbCw, line.style_dashed)
    lnCw := l2, lbCw := b2
    [l3, b3] = drawLevel(pw, cPut,   "PUT WALL",   lnPw, lbPw, line.style_dashed)
    lnPw := l3, lbPw := b3
    [l4, b4] = drawLevel(fl, cFlip,  "GAMMA FLIP", lnFl, lbFl, line.style_dotted)
    lnFl := l4, lbFl := b4

    // Regime shading — tint the band between price and the flip level
    if shadeRegime and fl > 0
        top = math.max(close, fl)
        bot = math.min(close, fl)
        col = posGamma ? color.new(#10b981, 92) : color.new(#ef4444, 92)
        if na(bgRegime)
            bgRegime := box.new(bar_index - lookback, top, bar_index, bot, border_color = color.new(color.gray, 100), bgcolor = col, extend = extend.right)
        else
            box.set_lefttop(bgRegime, bar_index - lookback, top)
            box.set_rightbottom(bgRegime, bar_index, bot)
            box.set_bgcolor(bgRegime, col)
    else if not na(bgRegime)
        box.delete(bgRegime)
        bgRegime := na

    // GEX-by-strike profile — horizontal bars anchored to the right edge
    if showProfile and str.length(profileStr) > 0
        for i = 0 to array.size(profBoxes) - 1
            box.delete(array.get(profBoxes, i))
        for i = 0 to array.size(profLabels) - 1
            label.delete(array.get(profLabels, i))
        array.clear(profBoxes)
        array.clear(profLabels)

        parts = str.split(profileStr, ",")
        // First pass: find the largest absolute GEX so bars can be scaled
        float maxAbs = 0.0
        for i = 0 to array.size(parts) - 1
            kv = str.split(str.trim(array.get(parts, i)), ":")
            if array.size(kv) == 2
                v = nz(str.tonumber(array.get(kv, 1)))
                maxAbs := math.max(maxAbs, math.abs(v))

        if maxAbs > 0
            for i = 0 to array.size(parts) - 1
                kv = str.split(str.trim(array.get(parts, i)), ":")
                if array.size(kv) == 2
                    strike = nz(str.tonumber(array.get(kv, 0))) * scaleMult
                    gexV   = nz(str.tonumber(array.get(kv, 1)))
                    if strike > 0 and gexV != 0
                        w  = math.round(math.abs(gexV) / maxAbs * profileW)
                        h  = syminfo.mintick * 20
                        bc = gexV >= 0 ? color.new(#10b981, 55) : color.new(#ef4444, 55)
                        array.push(profBoxes, box.new(bar_index + 2, strike + h, bar_index + 2 + math.max(w, 1), strike - h, border_color = color.new(bc, 100), bgcolor = bc))

    // Info table
    if showTable
        if na(info)
            info := table.new(position.top_right, 2, 6, border_width = 1)
        regimeTxt = fl <= 0 ? "—" : posGamma ? "POSITIVE Γ" : "NEGATIVE Γ"
        regimeCol = fl <= 0 ? color.gray : posGamma ? #10b981 : #ef4444
        note = fl <= 0 ? "set flip level" : posGamma ? "moves dampened · fade extremes" : "moves amplified · trend follows"

        table.cell(info, 0, 0, "FlowEdge Gamma", text_color = color.white, text_size = size.small, bgcolor = color.new(#6366f1, 20))
        table.cell(info, 1, 0, regimeTxt, text_color = regimeCol, text_size = size.small, bgcolor = color.new(#6366f1, 20))
        table.cell(info, 0, 1, "Net GEX", text_color = color.gray, text_size = size.tiny)
        table.cell(info, 1, 1, (netGex >= 0 ? "+" : "") + str.tostring(netGex, "#.##") + "B", text_color = netGex >= 0 ? #10b981 : #ef4444, text_size = size.tiny)
        table.cell(info, 0, 2, "Gamma wall", text_color = color.gray, text_size = size.tiny)
        table.cell(info, 1, 2, gw > 0 ? str.tostring(gw, format.mintick) : "—", text_color = cGamma, text_size = size.tiny)
        table.cell(info, 0, 3, "Call wall", text_color = color.gray, text_size = size.tiny)
        table.cell(info, 1, 3, cw > 0 ? str.tostring(cw, format.mintick) : "—", text_color = cCall, text_size = size.tiny)
        table.cell(info, 0, 4, "Put wall", text_color = color.gray, text_size = size.tiny)
        table.cell(info, 1, 4, pw > 0 ? str.tostring(pw, format.mintick) : "—", text_color = cPut, text_size = size.tiny)
        table.cell(info, 0, 5, "Regime", text_color = color.gray, text_size = size.tiny)
        table.cell(info, 1, 5, note, text_color = regimeCol, text_size = size.tiny)

// ── Alerts ──────────────────────────────────────────────────────────────────
// The flip cross is the one that matters most — it changes how the tape behaves,
// not just where it is.
flipUp   = fl > 0 and ta.crossover(close, fl)
flipDown = fl > 0 and ta.crossunder(close, fl)
atCall   = cw > 0 and high >= cw and low <= cw
atPut    = pw > 0 and high >= pw and low <= pw
atGamma  = gw > 0 and high >= gw and low <= gw

alertcondition(flipUp,   "Gamma flip — crossed UP",   "Price crossed above the gamma flip: dealers now long gamma, expect moves to get dampened.")
alertcondition(flipDown, "Gamma flip — crossed DOWN", "Price crossed below the gamma flip: dealers now short gamma, expect moves to get amplified.")
alertcondition(atCall,   "Touched call wall",         "Price is testing the call wall — heaviest call OI above spot.")
alertcondition(atPut,    "Touched put wall",          "Price is testing the put wall — heaviest put OI below spot.")
alertcondition(atGamma,  "Touched gamma wall",        "Price is at the gamma wall — the largest positive GEX strike, a pin/magnet.")

plotshape(flipUp,   "flip up",   shape.triangleup,   location.belowbar, cFlip, size = size.tiny)
plotshape(flipDown, "flip down", shape.triangledown, location.abovebar, cFlip, size = size.tiny)
