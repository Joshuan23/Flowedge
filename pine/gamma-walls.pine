// FlowEdge - Gamma Wall Levels
//
// Plots dealer-positioning levels (gamma wall, call/put walls, gamma flip)
// with regime shading and alerts.
//
// WHY THE LEVELS ARE INPUTS, NOT FETCHED:
// Pine Script has no HTTP access, so an indicator cannot call an options API.
// FlowEdge computes the levels from the live options chain and you paste them
// in. The Gamma tab has a "Pine inputs" button that copies them in this order.
//
// Refresh when the chain moves materially. GEX shifts intraday and hardest
// around OpEx.

//@version=6
indicator("FlowEdge Gamma Walls", "FE Gamma", overlay = true)

// ---- Levels (from the FlowEdge Gamma tab) ----------------------------------
gammaWall = input.float(0.0, "Gamma Wall (magnet)",    group = "Levels")
callWall  = input.float(0.0, "Call Wall (resistance)", group = "Levels")
putWall   = input.float(0.0, "Put Wall (support)",     group = "Levels")
flipLevel = input.float(0.0, "Gamma Flip (regime)",    group = "Levels")
netGex    = input.float(0.0, "Net GEX ($B)",           group = "Levels")
scaleMult = input.float(1.0, "Scale multiplier", minval = 0.0001, group = "Levels", tooltip = "Use 10 when levels come from SPY but you are charting SPX.")

// ---- Display ---------------------------------------------------------------
showLabels  = input.bool(true, "Show labels",         group = "Display")
showTable   = input.bool(true, "Show info table",     group = "Display")
shadeRegime = input.bool(true, "Shade gamma regime",  group = "Display")

cGamma = input.color(color.purple, "Gamma wall", group = "Display")
cCall  = input.color(color.teal,   "Call wall",  group = "Display")
cPut   = input.color(color.red,    "Put wall",   group = "Display")
cFlip  = input.color(color.orange, "Flip",       group = "Display")

// ---- Scaled levels ---------------------------------------------------------
gw = gammaWall * scaleMult
cw = callWall  * scaleMult
pw = putWall   * scaleMult
fl = flipLevel * scaleMult

// Above the flip dealers are long gamma and dampen moves. Below it they are
// short gamma and amplify them, which is the regime that trends.
posGamma = fl > 0 and close > fl

// ---- Level lines -----------------------------------------------------------
// plot() keeps this simple and reliable: a constant series renders as a
// horizontal line across the chart, and each gets its own price-scale label.
plot(gw > 0 ? gw : na, "Gamma Wall", color = cGamma, linewidth = 2)
plot(cw > 0 ? cw : na, "Call Wall",  color = cCall,  linewidth = 2)
plot(pw > 0 ? pw : na, "Put Wall",   color = cPut,   linewidth = 2)
plot(fl > 0 ? fl : na, "Gamma Flip", color = cFlip,  linewidth = 2)

// ---- Regime shading --------------------------------------------------------
regimeTint = shadeRegime and fl > 0 ? (posGamma ? color.new(color.teal, 92) : color.new(color.red, 92)) : na
bgcolor(regimeTint, title = "Gamma regime")

// ---- Labels ----------------------------------------------------------------
var label lbGamma = na
var label lbCall  = na
var label lbPut   = na
var label lbFlip  = na

if barstate.islast and showLabels
    label.delete(lbGamma)
    label.delete(lbCall)
    label.delete(lbPut)
    label.delete(lbFlip)

    if gw > 0
        pctG = close > 0 ? (gw - close) / close * 100 : 0.0
        txtG = "GAMMA WALL " + str.tostring(gw, format.mintick) + " (" + str.tostring(pctG, "#.##") + "%)"
        lbGamma := label.new(bar_index + 8, gw, txtG, style = label.style_label_left, color = color.new(cGamma, 80), textcolor = cGamma, size = size.small)
    if cw > 0
        pctC = close > 0 ? (cw - close) / close * 100 : 0.0
        txtC = "CALL WALL " + str.tostring(cw, format.mintick) + " (" + str.tostring(pctC, "#.##") + "%)"
        lbCall := label.new(bar_index + 8, cw, txtC, style = label.style_label_left, color = color.new(cCall, 80), textcolor = cCall, size = size.small)
    if pw > 0
        pctP = close > 0 ? (pw - close) / close * 100 : 0.0
        txtP = "PUT WALL " + str.tostring(pw, format.mintick) + " (" + str.tostring(pctP, "#.##") + "%)"
        lbPut := label.new(bar_index + 8, pw, txtP, style = label.style_label_left, color = color.new(cPut, 80), textcolor = cPut, size = size.small)
    if fl > 0
        pctF = close > 0 ? (fl - close) / close * 100 : 0.0
        txtF = "GAMMA FLIP " + str.tostring(fl, format.mintick) + " (" + str.tostring(pctF, "#.##") + "%)"
        lbFlip := label.new(bar_index + 8, fl, txtF, style = label.style_label_left, color = color.new(cFlip, 80), textcolor = cFlip, size = size.small)

// ---- Info table ------------------------------------------------------------
var table info = table.new(position.top_right, 2, 6, border_width = 1)

if barstate.islast and showTable
    regimeTxt = fl <= 0 ? "set flip level" : posGamma ? "POSITIVE GAMMA" : "NEGATIVE GAMMA"
    regimeCol = fl <= 0 ? color.gray : posGamma ? color.teal : color.red
    noteTxt   = fl <= 0 ? "-" : posGamma ? "moves dampened, fade extremes" : "moves amplified, trend follows"
    gexCol    = netGex >= 0 ? color.teal : color.red

    table.cell(info, 0, 0, "FlowEdge Gamma", text_color = color.white, text_size = size.small)
    table.cell(info, 1, 0, regimeTxt,        text_color = regimeCol,   text_size = size.small)
    table.cell(info, 0, 1, "Net GEX",    text_color = color.gray, text_size = size.tiny)
    table.cell(info, 1, 1, str.tostring(netGex, "#.##") + "B", text_color = gexCol, text_size = size.tiny)
    table.cell(info, 0, 2, "Gamma wall", text_color = color.gray, text_size = size.tiny)
    table.cell(info, 1, 2, gw > 0 ? str.tostring(gw, format.mintick) : "-", text_color = cGamma, text_size = size.tiny)
    table.cell(info, 0, 3, "Call wall",  text_color = color.gray, text_size = size.tiny)
    table.cell(info, 1, 3, cw > 0 ? str.tostring(cw, format.mintick) : "-", text_color = cCall, text_size = size.tiny)
    table.cell(info, 0, 4, "Put wall",   text_color = color.gray, text_size = size.tiny)
    table.cell(info, 1, 4, pw > 0 ? str.tostring(pw, format.mintick) : "-", text_color = cPut, text_size = size.tiny)
    table.cell(info, 0, 5, "Regime",     text_color = color.gray, text_size = size.tiny)
    table.cell(info, 1, 5, noteTxt,      text_color = regimeCol,  text_size = size.tiny)

// ---- Alerts ----------------------------------------------------------------
// The flip cross matters most: it changes how the tape behaves, not just where
// price is.
flipUp   = fl > 0 and ta.crossover(close, fl)
flipDown = fl > 0 and ta.crossunder(close, fl)
atCall   = cw > 0 and high >= cw and low <= cw
atPut    = pw > 0 and high >= pw and low <= pw
atGamma  = gw > 0 and high >= gw and low <= gw

alertcondition(flipUp,   "Gamma flip crossed UP",   "Price crossed above the gamma flip: dealers long gamma, moves get dampened.")
alertcondition(flipDown, "Gamma flip crossed DOWN", "Price crossed below the gamma flip: dealers short gamma, moves get amplified.")
alertcondition(atCall,   "Touched call wall",       "Price is testing the call wall.")
alertcondition(atPut,    "Touched put wall",        "Price is testing the put wall.")
alertcondition(atGamma,  "Touched gamma wall",      "Price is at the gamma wall, the largest positive GEX strike.")

plotshape(flipUp,   "Flip up",   shape.triangleup,   location.belowbar, cFlip, size = size.tiny)
plotshape(flipDown, "Flip down", shape.triangledown, location.abovebar, cFlip, size = size.tiny)
